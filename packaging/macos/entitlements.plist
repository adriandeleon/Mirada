<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The hardened runtime's exceptions Mirada needs, applied when it is signed with a Developer ID
  (scripts/sign-mac.sh). The JVM build (Intel Macs) compiles code at run time, which the first two
  allow; the native image needs neither, and is given the same file so both are signed alike.
  Library validation stays on: every library in the bundle is signed with Mirada's own identity.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
