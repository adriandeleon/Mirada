{
  "name": "Emacs",
  "bindings": {
    "go.next": ["n", "space", "right", "pagedown"],
    "go.previous": ["p", "backspace", "S-space", "left", "pageup"],
    "go.first": ["M-S-,", "home"],
    "go.last": ["M-S-.", "end"],
    "go.toImage": "C-s",
    "view.slideshow": "f5",
    "view.zoomIn": ["plus", "=", "S-=", "add"],
    "view.zoomOut": ["-", "subtract"],
    "view.zoomToFit": "0",
    "view.actualSize": "1",
    "view.keepZoom": "z",
    "view.panLeft": ["C-b", "S-left"],
    "view.panRight": ["C-f", "S-right"],
    "view.panUp": ["C-p", "up", "S-up"],
    "view.panDown": ["C-n", "down", "S-down"],
    "view.fullScreen": ["f", "f11"],
    "image.rotateRight": "r",
    "image.rotateLeft": "S-r",
    "image.edit": "e",
    "image.copy": "M-w",
    "file.rename": "f2",
    "file.moveToTrash": ["S-d", "delete"],
    "file.undoMoveToTrash": ["C-/", "C-S--"],
    "bookmark.image": "b",
    "bookmark.folder": "S-b",
    "bookmark.noteOnImage": "M-;",
    "bookmark.noteOnFolder": "M-S-;",
    "bookmark.next": "]",
    "bookmark.previous": "[",
    "bookmark.goTo": "C-j",
    "bookmark.list": "C-S-j",
    "view.properties": "i",
    "view.thumbnails": "t",
    "window.escape": ["escape", "C-g"],
    "app.settings": "C-,",
    "help.keyboardShortcuts": "C-h",
    "help.about": "f12",
    "file.open": "C-o",
    "file.openFolder": "C-S-f",
    "file.openRecent": "C-S-o",
    "window.close": ["q", "C-q"],
    "palette.show": ["C-S-p", "M-x", "f1"],

    "editor.save": ["C-s", "enter"],
    "editor.cancel": ["C-g", "escape"],
    "editor.undo": ["C-/", "C-S--", "C-z"],
    "editor.redo": ["C-?", "C-S-/", "C-M-S--"],
    "editor.rotateRight": "r",
    "editor.rotateLeft": "S-r",
    "editor.flipHorizontally": "h",
    "editor.flipVertically": "v",
    "editor.nextShape": "a",
    "editor.reset": "backspace",

    "bookmarks.open": "enter",
    "bookmarks.editNote": ["f2", "C-e"],
    "bookmarks.toggleBookmark": "C-b",
    "bookmarks.remove": "C-delete",
    "bookmarks.listAll": "C-1",
    "bookmarks.listBookmarked": "C-2",
    "bookmarks.listNotes": "C-3"
  },
  "vertical": {
    "go.next": ["n", "space", "down", "pagedown"],
    "go.previous": ["p", "backspace", "S-space", "up", "pageup"],
    "view.panLeft": ["C-b", "left", "S-left"],
    "view.panRight": ["C-f", "right", "S-right"],
    "view.panUp": ["C-p", "S-up"],
    "view.panDown": ["C-n", "S-down"]
  }
}
