<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mirada</groupId>
    <artifactId>mirada</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Mirada</name>
    <description>A fast, folder-oriented image viewer built on JavaFX</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <!-- Indirected through a property: the format is ignored when maven.build.timestamp is
             filtered into a resource directly. -->
        <maven.build.timestamp.format>yyyy-MM-dd HH:mm 'UTC'</maven.build.timestamp.format>
        <build.timestamp>${maven.build.timestamp}</build.timestamp>

        <javafx.version>27</javafx.version>
        <atlantafx.version>3.0.0</atlantafx.version>
        <!-- EXIF: orientation (phone photos are stored sideways and tagged), camera and exposure
             for the info line. 2.21 and later carry Automatic-Module-Name com.drew.metadata. Its
             one dependency, Adobe's xmpcore, has no module name and becomes the automatic module
             `xmpcore`. -->
        <metadata-extractor.version>2.22.0</metadata-extractor.version>
        <!-- The formats JavaFX does not decode, as pure-Java ImageIO plugins: WebP (lossy,
             lossless, the first frame of an animation), TIFF (beyond the JDK's own reader: JPEG and
             CMYK variants) and PSD (the flattened image). Read through com.mirada.image.ImageIoDecoder. -->
        <twelvemonkeys.version>3.15.3</twelvemonkeys.version>
        <spotless.version>3.6.0</spotless.version>
        <palantir.version>2.92.0</palantir.version>
        <javafx.plugin.version>0.0.8</javafx.plugin.version>
        <junit.version>5.14.4</junit.version>
        <junit.platform.version>1.14.4</junit.platform.version>
        <!-- Null checking (AGENTS.md, "Null annotations"): NullAway, an Error Prone plugin,
             checks every @NullMarked package of the main compile and fails the build on a null it
             cannot prove safe. JSpecify supplies the annotations. Error Prone reaches into javac,
             hence .mvn/jvm.config. Editora's setup. -->
        <jspecify.version>1.0.1</jspecify.version>
        <errorprone.version>2.50.0</errorprone.version>
        <nullaway.version>0.14.2</nullaway.version>

        <!-- Prism pipeline order (-Dprism.order). Set per-OS in the os-* profiles:
             mac=mtl,es2,sw (Metal), windows=d3d,es2,sw, linux=es2,sw. This default covers
             profile-less builds (e.g. plain `mvn test`, which doesn't render). -->
        <prism.pipeline>es2,sw</prism.pipeline>

        <!-- dist profile only -->
        <moditect.version>1.3.0.Final</moditect.version>
        <jpackage.plugin.version>1.8.0</jpackage.plugin.version>
        <!-- What jpackage writes: Mirada/ on Linux and Windows, Mirada.app on macOS (os-mac). -->
        <jpackage.imageName>Mirada</jpackage.imageName>
        <!-- jpackage wants .png on Linux, .icns on macOS, .ico on Windows; the os-* profiles pick. -->
        <jpackage.icon>${project.basedir}/branding/mirada.png</jpackage.icon>
        <!-- Installers take minutes the dev loop never wants; CI and the release turn them on. -->
        <skip.installers>true</skip.installers>

        <!-- The native codec bundle (libheif, libjxl): built by the Codecs workflow from
             scripts/build-codecs.sh and published as a release; downloaded, checked against the
             checksum of this platform's zip (the codecs-* profiles below) and unpacked into
             codecs.dir, where runs and tests load it from. The download is cached in
             ~/.m2/repository/.cache. -Dcodecs.skip keeps a bundle you built locally. -->
        <codecs.release>codecs-1</codecs.release>
        <codecs.dir>${project.build.directory}/codecs</codecs.dir>
        <codecs.platform>none</codecs.platform>
        <codecs.sha256>none</codecs.sha256>
        <!-- On until a codecs-* profile recognises the platform. -->
        <codecs.skip>true</codecs.skip>
    </properties>

    <dependencies>
        <!-- Compile-time only (`requires static org.jspecify`): the annotations are read by
             NullAway, and a missing annotation class is ignored by reflection at run time, so
             nothing ships. -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
            <version>${jspecify.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.mkpaz</groupId>
            <artifactId>atlantafx-base</artifactId>
            <version>${atlantafx.version}</version>
        </dependency>
        <dependency>
            <groupId>com.drewnoakes</groupId>
            <artifactId>metadata-extractor</artifactId>
            <version>${metadata-extractor.version}</version>
        </dependency>

        <dependency>
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-webp</artifactId>
            <version>${twelvemonkeys.version}</version>
        </dependency>
        <dependency>
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-tiff</artifactId>
            <version>${twelvemonkeys.version}</version>
        </dependency>
        <dependency>
            <groupId>com.twelvemonkeys.imageio</groupId>
            <artifactId>imageio-psd</artifactId>
            <version>${twelvemonkeys.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <version>${junit.platform.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- build-info.properties is filtered so the version comes from this pom and nowhere
                 else; every other file reads it through AppInfo. Everything else is copied
                 verbatim — filtering the CSS would mangle any ${...} it contains. -->
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes><include>com/mirada/build-info.properties</include></includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes><exclude>com/mirada/build-info.properties</exclude></excludes>
            </resource>
        </resources>
        <plugins>
            <!-- The JDK this project is built, tested and run on, as in Termina and Torrenta: the
                 formatter breaks on 27. Pass -Denforcer.skip to try another on purpose. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>jdk-25</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,26)</version>
                                    <message>Mirada builds and runs on JDK 25: set JAVA_HOME to a 25 (sdkman: 25.0.4-tem). JDK 27 breaks the formatter.</message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <removeUnusedImports/>
                        <palantirJavaFormat>
                            <version>${palantir.version}</version>
                        </palantirJavaFormat>
                        <!-- importOrder runs AFTER Palantir so it has the final say on grouping:
                             JDK, then javafx, then everything else, then static imports last. -->
                        <importOrder>
                            <order>java|javax,javafx,,\#</order>
                        </importOrder>
                        <toggleOffOn/>
                    </java>
                </configuration>
                <executions>
                    <execution>
                        <!-- verify, not compile: `mvn javafx:run` and the compile loop stay
                             untouched, and CI still refuses unformatted code. -->
                        <id>spotless-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <executions>
                    <execution>
                        <!-- NullAway only: every other Error Prone check is off. OnlyNullMarked
                             leaves a package unchecked until its package-info.java says
                             @NullMarked. Tests are not checked. -->
                        <id>default-compile</id>
                        <configuration>
                            <compilerArgs>
                                <arg>-XDcompilePolicy=simple</arg>
                                <arg>--should-stop=ifError=FLOW</arg>
                                <arg>-Xplugin:ErrorProne -XepDisableAllChecks -Xep:NullAway:ERROR -XepOpt:NullAway:OnlyNullMarked=true -XepOpt:NullAway:JSpecifyMode=true</arg>
                            </compilerArgs>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>com.google.errorprone</groupId>
                                    <artifactId>error_prone_core</artifactId>
                                    <version>${errorprone.version}</version>
                                </path>
                                <path>
                                    <groupId>com.uber.nullaway</groupId>
                                    <artifactId>nullaway</artifactId>
                                    <version>${nullaway.version}</version>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
                <configuration>
                    <!-- Tests run on the classpath (unnamed module) so they can reach
                         package-private members freely. -->
                    <useModulePath>false</useModulePath>
                    <systemPropertyVariables>
                        <!-- JavaFX's headless platform and software rendering, for any test that
                             makes a Node. Set here, before any test class loads, because Prism
                             reads them once, in static initialisers. -->
                        <glass.platform>Headless</glass.platform>
                        <prism.order>sw</prism.order>
                        <!-- As App.main does: the decoder tests make BufferedImages, and on macOS
                             an initialised AWT contends with JavaFX. -->
                        <java.awt.headless>true</java.awt.headless>
                        <mirada.codecs>${codecs.dir}</mirada.codecs>
                    </systemPropertyVariables>
                    <!-- JavaFX loads its native libraries from the classpath here; without this the
                         JDK warns that it will refuse in a future release. -->
                    <argLine>--enable-native-access=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>com.googlecode.maven-download-plugin</groupId>
                <artifactId>download-maven-plugin</artifactId>
                <version>1.13.0</version>
                <executions>
                    <execution>
                        <id>codecs</id>
                        <phase>generate-resources</phase>
                        <goals><goal>wget</goal></goals>
                        <configuration>
                            <url>https://github.com/adriandeleon/Mirada/releases/download/${codecs.release}/mirada-codecs-${codecs.platform}.zip</url>
                            <sha256>${codecs.sha256}</sha256>
                            <unpack>true</unpack>
                            <outputDirectory>${codecs.dir}</outputDirectory>
                            <skip>${codecs.skip}</skip>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>${javafx.plugin.version}</version>
                <configuration>
                    <mainClass>com.mirada/com.mirada.App</mainClass>
                    <options>
                        <option>--enable-native-access=javafx.graphics,com.mirada</option>
                        <option>-Dprism.order=${prism.pipeline}</option>
                        <!-- The codec bundle (scripts/build-codecs.sh, or the release the build
                             downloads). Absent, the system's libheif and libjxl are used. -->
                        <option>-Dmirada.codecs=${codecs.dir}</option>
                    </options>
                    <launcher>mirada</launcher>
                    <jlinkImageName>mirada</jlinkImageName>
                    <jlinkZipName>mirada</jlinkZipName>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>os-mac</id>
            <activation><os><family>mac</family></os></activation>
            <properties>
                <prism.pipeline>mtl,es2,sw</prism.pipeline>
                <jpackage.imageName>Mirada.app</jpackage.imageName>
                <jpackage.icon>${project.basedir}/branding/mirada.icns</jpackage.icon>
            </properties>
        </profile>
        <profile>
            <id>os-windows</id>
            <activation><os><family>windows</family></os></activation>
            <properties>
                <prism.pipeline>d3d,es2,sw</prism.pipeline>
                <jpackage.icon>${project.basedir}/branding/mirada.ico</jpackage.icon>
            </properties>
        </profile>
        <profile>
            <id>os-linux</id>
            <activation><os><family>unix</family><name>Linux</name></os></activation>
            <properties>
                <prism.pipeline>es2,sw</prism.pipeline>
            </properties>
        </profile>
        <!--
          The app image: ./mvnw clean -Pdist -DskipTests package => target/dist/Mirada{.app}.
          `clean` is required: jlink's input is built from target/classes, and an incremental
          compile can leave it inconsistent. Termina's profile, trimmed to what Mirada needs: jlink
          a runtime with the app in it, copy the codec bundle in, then record the AOT cache.
        -->
        <profile>
            <id>dist</id>
            <build>
                <plugins>
                    <!-- jlink links only explicit modules. These ten are automatic (a name in the
                         manifest, no descriptor), so each gets one generated by jdeps, which also
                         writes the TwelveMonkeys readers' `provides` from their META-INF/services.
                         None of them looks a service up itself, so no `uses` is missing. -->
                    <plugin>
                        <groupId>org.moditect</groupId>
                        <artifactId>moditect-maven-plugin</artifactId>
                        <version>${moditect.version}</version>
                        <executions>
                            <execution>
                                <id>patch-automatic-modules</id>
                                <phase>package</phase>
                                <goals><goal>add-module-info</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/modules</outputDirectory>
                                    <overwriteExistingFiles>true</overwriteExistingFiles>
                                    <jdepsExtraArgs>
                                        <arg>--multi-release=25</arg>
                                        <arg>--ignore-missing-deps</arg>
                                    </jdepsExtraArgs>
                                    <modules>
                                        <module>
                                            <artifact>
                                                <groupId>com.twelvemonkeys.common</groupId>
                                                <artifactId>common-lang</artifactId>
                                                <version>${twelvemonkeys.version}</version>
                                            </artifact>
                                            <moduleInfo><name>com.twelvemonkeys.common.lang</name></moduleInfo>
                                        </module>
                                        <module>
                                            <artifact>
                                                <groupId>com.twelvemonkeys.common</groupId>
                                                <artifactId>common-io</artifactId>
                                                <version>${twelvemonkeys.version}</version>
                                            </artifact>
                                            <moduleInfo><name>com.twelvemonkeys.common.io</name></moduleInfo>
                                        </module>
                                        <module>
                                            <artifact>
                                                <groupId>com.twelvemonkeys.common</groupId>
                                                <artifactId>common-image</artifactId>
                                                <version>${twelvemonkeys.version}</version>
                                            </artifact>
                                            <moduleInfo><name>com.twelvemonkeys.common.image</name></moduleInfo>
                                        </module>
                                        <module>
                                            <artifact>
                                                <groupId>com.twelvemonkeys.imageio</groupId>
                                                <artifactId>imageio-core</artifactId>
                                                <version>${twelvemonkeys.version}</version>
                                            </artifact>
                                            <moduleInfo><name>com.twelvemonkeys.imageio.core</name></moduleInfo>
                                        </module>
                                        <module>
                                            <artifact>
                                                <groupId>com.twelvemonkeys.imageio</groupId>
                                                <artifactId>imageio-metadata</artifactId>
                                                <version>${twelvemonkeys.version}</version>
                                            </artifact>
                                            <moduleInfo><name>com.twelvemonkeys.imageio.metadata</name></moduleInfo>
                                        </module>
                                        <module>
                                            <artifact>
                                                <groupId>com.twelvemonkeys.imageio</groupId>
                                                <artifactId>imageio-webp</artifactId>
                                                <version>${twelvemonkeys.version}</version>
                                            </artifact>
                                            <moduleInfo><name>com.twelvemonkeys.imageio.webp</name></moduleInfo>
                                        </module>
                                        <module>
                                            <artifact>
                                                <groupId>com.twelvemonkeys.imageio</groupId>
                                                <artifactId>imageio-tiff</artifactId>
                                                <version>${twelvemonkeys.version}</version>
                                            </artifact>
                                            <moduleInfo><name>com.twelvemonkeys.imageio.tiff</name></moduleInfo>
                                        </module>
                                        <module>
                                            <artifact>
                                                <groupId>com.twelvemonkeys.imageio</groupId>
                                                <artifactId>imageio-psd</artifactId>
                                                <version>${twelvemonkeys.version}</version>
                                            </artifact>
                                            <moduleInfo><name>com.twelvemonkeys.imageio.psd</name></moduleInfo>
                                        </module>
                                        <module>
                                            <artifact>
                                                <groupId>com.adobe.xmp</groupId>
                                                <artifactId>xmpcore</artifactId>
                                                <version>6.1.11</version>
                                            </artifact>
                                            <moduleInfo><name>xmpcore</name></moduleInfo>
                                        </module>
                                        <module>
                                            <artifact>
                                                <groupId>com.drewnoakes</groupId>
                                                <artifactId>metadata-extractor</artifactId>
                                                <version>${metadata-extractor.version}</version>
                                            </artifact>
                                            <moduleInfo><name>com.drew.metadata</name></moduleInfo>
                                        </module>
                                    </modules>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.11.0</version>
                        <executions>
                            <execution>
                                <id>collect-modules</id>
                                <phase>package</phase>
                                <goals><goal>copy-dependencies</goal></goals>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/mods</outputDirectory>
                                    <includeScope>runtime</includeScope>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <!-- 3.1.0, as Termina: 3.2.0 warns once per exported property. -->
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <!-- jpackage refuses a version it cannot parse, and macOS one whose
                                     first number is zero; the pom's own version still reaches the
                                     app through build-info.properties. -->
                                <id>derive-versions</id>
                                <phase>initialize</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <exportAntProperties>true</exportAntProperties>
                                    <target>
                                        <loadresource property="jpackage.numericVersion">
                                            <string value="${project.version}"/>
                                            <filterchain>
                                                <tokenfilter>
                                                    <replaceregex pattern="-.*$" replace=""/>
                                                </tokenfilter>
                                            </filterchain>
                                        </loadresource>
                                        <loadresource property="jpackage.macVersion">
                                            <string value="${jpackage.numericVersion}"/>
                                            <filterchain>
                                                <tokenfilter>
                                                    <replaceregex pattern="^0\." replace="1."/>
                                                </tokenfilter>
                                            </filterchain>
                                        </loadresource>
                                        <condition property="jpackage.appVersion"
                                                   value="${jpackage.macVersion}"
                                                   else="${jpackage.numericVersion}">
                                            <os family="mac"/>
                                        </condition>
                                    </target>
                                </configuration>
                            </execution>
                            <execution>
                                <id>assemble-module-path</id>
                                <phase>package</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <!-- Patched jars win over the plain automatic ones. -->
                                        <copy todir="${project.build.directory}/mods" overwrite="true">
                                            <fileset dir="${project.build.directory}/modules"/>
                                        </copy>
                                        <copy todir="${project.build.directory}/mods"
                                              file="${project.build.directory}/${project.build.finalName}.jar"/>
                                        <!-- JavaFX's stub jar and its platform jar declare the same
                                             module; both on the path is a duplicate-module error. -->
                                        <delete>
                                            <fileset dir="${project.build.directory}/mods"
                                                     includes="javafx-*-${javafx.version}.jar"/>
                                        </delete>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.panteleyev</groupId>
                        <artifactId>jpackage-maven-plugin</artifactId>
                        <version>${jpackage.plugin.version}</version>
                        <executions>
                            <execution>
                                <id>app-image</id>
                                <phase>package</phase>
                                <goals><goal>jpackage</goal></goals>
                                <configuration>
                                    <type>APP_IMAGE</type>
                                    <name>Mirada</name>
                                    <appVersion>${jpackage.appVersion}</appVersion>
                                    <vendor>Mirada</vendor>
                                    <icon>${jpackage.icon}</icon>
                                    <destination>${project.build.directory}/dist</destination>
                                    <module>com.mirada/com.mirada.App</module>
                                    <modulePaths>
                                        <modulePath>${project.build.directory}/mods</modulePath>
                                    </modulePaths>
                                    <javaOptions>
                                        <javaOption>--enable-native-access=javafx.graphics,com.mirada</javaOption>
                                        <javaOption>-Dprism.order=${prism.pipeline}</javaOption>
                                        <!-- $APPDIR is the installed image's app directory, so both
                                             survive the bundle being moved. scripts/add-codecs.sh
                                             puts the bundle there; scripts/aot-train.sh the cache.
                                             Under the default AOTMode=auto a missing or stale cache
                                             is a warning and a normal start. -->
                                        <javaOption>-Dmirada.codecs=$APPDIR/codecs</javaOption>
                                        <javaOption>-XX:AOTCache=$APPDIR/mirada.aot</javaOption>
                                        <!-- Returns idle heap to the OS: a viewer left open on one
                                             photo should not keep what a burst of 48-megapixel
                                             decodes cost it. No -Xmx: images legitimately need
                                             hundreds of megabytes, and the cache is bounded. -->
                                        <javaOption>-XX:G1PeriodicGCInterval=30000</javaOption>
                                    </javaOptions>
                                    <jLinkOptions>
                                        <jLinkOption>--strip-debug</jLinkOption>
                                        <jLinkOption>--no-man-pages</jLinkOption>
                                        <jLinkOption>--no-header-files</jLinkOption>
                                        <jLinkOption>--compress=zip-6</jLinkOption>
                                        <!-- javax.sound's native half: Mirada plays nothing, and on
                                             Linux it would make the deb depend on the build host's
                                             ALSA package (Termina's 0.12.0 lesson). -->
                                        <jLinkOption>--exclude-files=glob:/java.desktop/**jsound.*</jLinkOption>
                                    </jLinkOptions>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.6.4</version>
                        <executions>
                            <!-- All after jpackage (same phase, so POM order), and the codecs before
                                 training, so the training run decodes HEIC, AVIF and JPEG XL. -->
                            <execution>
                                <id>linux-launcher</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/scripts/linux-launcher.sh</argument>
                                        <argument>${project.build.directory}/dist/${jpackage.imageName}</argument>
                                        <argument>Mirada</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>add-notices</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/scripts/add-notices.sh</argument>
                                        <argument>${project.build.directory}/dist/${jpackage.imageName}</argument>
                                        <argument>${project.basedir}/LICENSE</argument>
                                        <argument>${project.basedir}/NOTICE</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>add-codecs</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/scripts/add-codecs.sh</argument>
                                        <argument>${project.build.directory}/dist/${jpackage.imageName}</argument>
                                        <argument>${codecs.dir}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>aot-train</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/scripts/aot-train.sh</argument>
                                        <argument>${project.build.directory}/dist/${jpackage.imageName}</argument>
                                        <argument>mirada.aot</argument>
                                        <argument>${project.basedir}/src/test/resources/com/mirada/image</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <!-- Last: every earlier step changed the bundle. Exits at once off macOS. -->
                                <id>fix-mac-bundle</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/scripts/fix-mac-bundle.sh</argument>
                                        <argument>${project.build.directory}/dist/Mirada.app</argument>
                                        <argument>${jpackage.numericVersion}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <!-- Last, so it wraps a finished image. Opt-in with
                                     -Dskip.installers=false (CI, the release). -->
                                <id>build-installers</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/scripts/build-installers.sh</argument>
                                        <argument>${project.build.directory}/dist/${jpackage.imageName}</argument>
                                        <argument>${jpackage.appVersion}</argument>
                                        <argument>${project.build.directory}/installers</argument>
                                        <argument>${jpackage.icon}</argument>
                                    </arguments>
                                    <skip>${skip.installers}</skip>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

